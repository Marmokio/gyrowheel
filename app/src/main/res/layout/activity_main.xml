<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#121212"
    android:padding="16dp" android:gravity="center">

    <EditText android:id="@+id/ipInput" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="IP: 192.168.1.xx"
        android:textColor="#FFF" android:layout_marginBottom="16dp"/>
    
    <Button android:id="@+id/btnConnect" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Подключить руль" />

    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Не подключено"
        android:textColor="#FF0000" android:textSize="24sp" android:layout_marginTop="32dp"/>

    <Button android:id="@+id/btnCalibrate" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="КАЛИБРОВАТЬ"
        android:layout_marginTop="32dp"/>

    <Button android:id="@+id/btnGas" android:layout_width="match_parent"
        android:layout_height="200dp" android:text="ГАЗ"
        android:textSize="40sp" android:backgroundTint="#00FF00"
        android:layout_marginTop="32dp"/>
</LinearLayout>
